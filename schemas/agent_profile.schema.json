{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Profile",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "agent_role",
    "runner",
    "write_access"
  ],
  "properties": {
    "schema_version": {
      "type": "integer"
    },
    "profile_id": {
      "type": "string"
    },
    "agent_role": {
      "type": "string"
    },
    "runner": {
      "type": "string"
    },
    "write_access": {
      "type": "boolean"
    }
  }
}
