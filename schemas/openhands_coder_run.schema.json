{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenHands Coder Run",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "created_utc",
    "generated_by",
    "status",
    "objective",
    "canonical_repo",
    "worktree_path",
    "worktree_git_branch",
    "command_argv_redacted",
    "execution_performed"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "created_utc": { "type": "string", "minLength": 1 },
    "generated_by": {
      "enum": [
        "phase18b_controlled_openhands_coder_execution",
        "phase18e_fresh_worktree_and_scope_guard",
        "phase18f_manual_nonsmoke_write_gate"
      ]
    },
    "status": { "enum": ["pass", "warn", "fail"] },
    "objective": { "type": "object" },
    "canonical_repo": { "type": "string", "minLength": 1 },
    "worktree_path": { "type": "string", "minLength": 1 },
    "worktree_git_branch": { "type": "string", "minLength": 1 },
    "artifacts_read": { "type": "object" },
    "env_summary": { "type": "object" },
    "command_argv_redacted": {
      "type": "array",
      "items": { "type": "string" }
    },
    "manual_allowed_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "task_override_used": { "type": "boolean" },
    "task_type": {
      "enum": ["generated", "smoke", "manual_task_text", "manual_task_file"]
    },
    "execution_performed": { "type": "boolean" },
    "required_artifacts": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
