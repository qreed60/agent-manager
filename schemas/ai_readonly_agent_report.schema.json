{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-manager.local/schemas/ai_readonly_agent_report.schema.json",
  "title": "AI Read-Only Agent Report",
  "description": "Schema for AI read-only agent artifacts generated by Phase 18A.",
  "type": "object",
  "required": [
    "schema_version",
    "agent",
    "project_id",
    "created_utc",
    "run_dir",
    "model_call_performed",
    "safety_status",
    "artifacts_generated",
    "generated_by"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [1]
    },
    "agent": {
      "type": "string",
      "const": "ai_readonly_agent"
    },
    "project_id": {
      "type": "string"
    },
    "created_utc": {
      "type": "string",
      "pattern": "^\\d{8}T\\d{6}Z$"
    },
    "run_dir": {
      "type": "string"
    },
    "model_call_performed": {
      "type": "boolean"
    },
    "safety_status": {
      "type": "object",
      "required": [
        "source_writes_allowed",
        "openhands_execution_allowed",
        "auto_push_allowed",
        "auto_merge_allowed",
        "pr_creation_allowed"
      ],
      "properties": {
        "model_call_performed": { "type": ["boolean", "null"] },
        "dry_run": { "type": ["boolean", "null"] },
        "model_name": { "type": ["string", "null"] },
        "base_url_host_only": { "type": ["string", "null"] },
        "timeout_seconds": { "type": ["integer", "null"] },
        "prompt_size_chars": { "type": ["integer", "null"] },
        "response_size_chars": { "type": ["integer", "null"] },
        "error": { "type": ["string", "null"] },
        "source_writes_allowed": { "type": "boolean" },
        "openhands_execution_allowed": { "type": "boolean" },
        "auto_push_allowed": { "type": "boolean" },
        "auto_merge_allowed": { "type": "boolean" },
        "pr_creation_allowed": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "artifacts_generated": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 8
    },
    "generated_by": {
      "type": "string",
      "const": "phase18a_ai_readonly_agent"
    }
  },
  "additionalProperties": true
}
