{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FeatureBrief",
  "description": "Structured feature brief for intake-only Phase 21. Deterministic, non-executing.",
  "type": "object",
  "required": [
    "schema_version",
    "generated_by",
    "created_utc",
    "project_id",
    "feature_id",
    "title",
    "high_level_goal",
    "desired_behavior",
    "must_have_requirements",
    "risk_level",
    "target_project_area",
    "human_priority",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Schema version for this feature brief format."
    },
    "generated_by": {
      "type": "string",
      "enum": ["phase21_feature_brief_intake"],
      "description": "Component that generated this artifact."
    },
    "created_utc": {
      "type": "string",
      "pattern": "^\\d{8}T\\d{6}Z$",
      "description": "UTC timestamp in YYYYMMDDTHHMMSSZ format."
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "description": "Registered project identifier from configs/projects.json."
    },
    "feature_id": {
      "type": "string",
      "pattern": "^feat_[a-z0-9_]+$",
      "description": "Stable feature identifier derived from title slug."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Short descriptive title for the feature."
    },
    "high_level_goal": {
      "type": "string",
      "minLength": 1,
      "description": "High-level goal statement."
    },
    "desired_behavior": {
      "type": "string",
      "minLength": 1,
      "description": "Desired behavior description."
    },
    "must_have_requirements": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "description": "Must-have requirements list."
    },
    "nice_to_have_requirements": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Nice-to-have requirements list (optional)."
    },
    "constraints": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Constraints list (optional)."
    },
    "out_of_scope": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Out-of-scope items list (optional)."
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high"],
      "description": "Risk level: low, medium, or high."
    },
    "target_project_area": {
      "type": "string",
      "minLength": 1,
      "description": "Target project area for the feature."
    },
    "human_priority": {
      "oneOf": [
        {"type": "integer"},
        {"type": "number"}
      ],
      "minimum": 1,
      "maximum": 5,
      "description": "Human-priority score (1-5)."
    },
    "status": {
      "type": "string",
      "enum": ["brief_only", "needs_clarification", "ready_for_architecture", "blocked", "archived"],
      "description": "Current status of the feature brief."
    }
  },
  "additionalProperties": false
}
