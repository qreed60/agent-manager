[Unit]
Description=Agent Manager deterministic nightly window for project %i
Documentation=man:systemd.service(5)

[Service]
Type=oneshot
WorkingDirectory=/home/qreed/agent-manager
Environment=PATH=/home/qreed/agent-manager/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=AGENT_MANAGER_NO_MODEL_CALLS=1
Environment=AGENT_MANAGER_NO_OPENHANDS=1
Environment=AGENT_MANAGER_MAX_CODE_WRITING_TASKS=0
ExecStart=/home/qreed/agent-manager/.venv/bin/python /home/qreed/agent-manager/scripts/run_nightly_window.py %i
Restart=no
